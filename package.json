{
  "name": "kificut",
  "productName": "Kificut",
  "desktopName": "kificut.desktop",
  "version": "0.3.0",
  "description": "A fast, open source video editor for Windows, macOS and Linux.",
  "license": "MIT",
  "author": "Kificut contributors",
  "homepage": "https://github.com/Kificut-app/kificut",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kificut-app/kificut.git"
  },
  "bugs": {
    "url": "https://github.com/Kificut-app/kificut/issues"
  },
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "postinstall": "node scripts/fetch-ffprobe.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build && npm run build:connector",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "brand:sound": "node scripts/brand-sound.mjs",
    "build:connector": "node scripts/build-connector.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@anthropic-ai/sdk": "^1.9.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@huggingface/transformers": "^3.8.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ffmpeg-static": "^5.3.0",
    "globals": "^17.14.0",
    "immer": "^11.2.10",
    "kokoro-js": "^1.2.1",
    "lucide-react": "^1.73.0",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
